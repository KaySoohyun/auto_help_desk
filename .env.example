# Configuración de la app (Auto Help Desk API)
# Referencia de campos: `app/core/config.py` (pydantic-settings).

# --- Obligatorias ----------------------------------------------------------

# Clave de firma JWT (mín. 32 chars). Generar: openssl rand -hex 32
SECRET_KEY=change-me-32-chars-minimo-cambia-me-please

# DB de producción (FastAPI Cloud: URL de la integración Supabase).
DATABASE_URL=postgresql://usuario:password@host:5432/autohelpdesk

# --- Selección de proveedor LLM (018) --------------------------------------
# Valores: mock (dev/tests, sin red) | gemini | openrouter | http (genérico)
LLM_PROVIDER=mock

# Con LLM_PROVIDER=gemini (Google AI Studio, endpoint OpenAI-compatible):
GEMINI_API_KEY=AIza-xxxx
GEMINI_MODEL=gemini-3.6-flash
# GEMINI_PROJECT_ID=projects/XXXX   # no requerido para AI Studio; solo Vertex AI

# Con LLM_PROVIDER=openrouter:
# OPENROUTER_API_KEY=sk-or-xxxx

# Con LLM_PROVIDER=http (proveedor OpenAI-compatible genérico):
# LLM_BASE_URL=https://llm.gateway.example.com   # SIN /v1 al final
# LLM_API_KEY=sk-xxxx
# LLM_CHAT_PATH=/v1/chat/completions

# --- Ajustes del proveedor LLM (opcionales, con defaults) --------------------
# LLM_MODEL=gpt-4o-mini
# LLM_TIMEOUT_SECONDS=15
# LLM_MAX_RETRIES=2
# LLM_RETRY_BACKOFF=0.5
# LLM_MAX_TOKENS=1024
# LLM_RATE_MAX_CALLS=60
# LLM_RATE_WINDOW_SECONDS=60

# --- Auth / JWT (opcionales, con defaults) -----------------------------------
# ACCESS_TOKEN_EXPIRE_MINUTES=15
# REFRESH_TOKEN_EXPIRE_DAYS=30
# JWT_ALGORITHM=HS256
# JWT_ISSUER=api.example.com
# JWT_AUDIENCE=api.example.com

# --- Usuario admin de operación (fuera de la app; solo referencia de ops) -----
# El `/auth/register` NO permite roles admin; el admin se crea por seed/DB.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me

# --- IA y guardrails (opcionales, con defaults) -------------------------------
# AI_FEATURES_ENABLED=true            # false = kill-switch (endpoints IA → 503)
# AI_CONFIDENCE_THRESHOLD=0.6
# GUARDRAILS_ENABLED=true
# Guardrails (listas JSON; si no se setean, usan los defaults):
# GUARDRAIL_PROHIBITED_PATTERNS=["ignor(?:a|e|ar) ..."]
# GUARDRAIL_INJECTION_PATTERNS=["..."]
